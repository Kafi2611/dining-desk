# Copy this file to .env and change the values.
# Database used by "npm run dev" (docker compose up -d db)
DATABASE_URL="postgresql://diningdesk:diningdesk@localhost:5432/diningdesk"

# Auth.js secret. Make your own: npx auth secret (or any long random text)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Host port for the db container. Change it if 5432 is blocked on your PC (then change DATABASE_URL too).
DB_PORT=5432

# Used by docker-compose.yml for the db container
POSTGRES_USER=diningdesk
POSTGRES_PASSWORD=diningdesk
POSTGRES_DB=diningdesk
