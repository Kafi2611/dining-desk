-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc-33" value="Green = student · Blue = manager · Grey = shared / included. Covers FR1–FR12 in PLAN.md." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=11;align=left;spacingLeft=6;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="1000" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UML class diagram" id="uml"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="uml-1" value="DiningDesk – UML class diagram (patterns are shown as coloured groups)" style="text;html=1;align=left;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="uml-2" value="&lt;b&gt;Domain model&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#6b7280;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="560" height="540" as="geometry"/></mxCell><mxCell id="uml-3" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;b&gt;User&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- id: string&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- roll: string&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- name: string&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- passwordHash: string&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- role: Role&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="200" y="95" width="200" height="126" as="geometry"/></mxCell><mxCell id="uml-4" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;b&gt;Student&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- hallId: string&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;+ canTransferTo(s: Student): boolean&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="190" height="86" as="geometry"/></mxCell><mxCell id="uml-5" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;b&gt;Manager&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0'&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;+ setRates(...): void&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;+ approveRecharge(id): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="370" y="270" width="190" height="86" as="geometry"/></mxCell><mxCell id="uml-6" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;b&gt;Wallet&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- balance: number  (poisha)&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;+ debit(amount): void&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;+ credit(amount): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="190" height="102" as="geometry"/></mxCell><mxCell id="uml-7" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;b&gt;Transaction&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- type: TxnType&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- status: TxnStatus&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- amount: number&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- balanceAfter: number&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="300" y="400" width="260" height="110" as="geometry"/></mxCell><mxCell id="uml-8" value="" style="endArrow=block;endFill=0;endSize=12;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="uml-4" target="uml-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uml-9" value="" style="endArrow=block;endFill=0;endSize=12;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="uml-5" target="uml-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uml-10" value="1 : 1" style="startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" parent="1" source="uml-4" target="uml-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uml-11" value="1 : *" style="startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" parent="1" source="uml-6" target="uml-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uml-12" value="&lt;b&gt;Factory Method (creational) – creates the right token&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#15803d;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontColor=#15803d;" vertex="1" parent="1"><mxGeometry x="610" y="60" width="560" height="540" as="geometry"/></mxCell><mxCell id="uml-13" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;span style='font-size:10px'&gt;«abstract  ·  Creator»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;TokenSeller&lt;/i&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;# settings: Settings&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;+ sell(s: Student, date, meal): MealToken&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;# checkCommonRules(s, date): void&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;# checkExtraRules(s, date): void  {hook}&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;# createToken(date, meal): MealToken  {abstract}&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="690" y="95" width="330" height="160" as="geometry"/></mxCell><mxCell id="uml-14" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;span style='font-size:10px'&gt;«ConcreteCreator»&lt;/span&gt;&lt;br&gt;&lt;b&gt;RegularTokenSeller&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0'&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;# createToken(date, meal): MealToken&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="230" height="96" as="geometry"/></mxCell><mxCell id="uml-15" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;span style='font-size:10px'&gt;«ConcreteCreator»&lt;/span&gt;&lt;br&gt;&lt;b&gt;GuestCouponSeller&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0'&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;# checkExtraRules(s, date)  (10 per day)&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;# createToken(date, meal): MealToken&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="255" height="112" as="geometry"/></mxCell><mxCell id="uml-16" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;span style='font-size:10px'&gt;«abstract  ·  Product»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;MealToken&lt;/i&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- date: Date&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- mealType: MealType&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;+ price(s: Settings): number  {abstract}&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="650" y="430" width="230" height="128" as="geometry"/></mxCell><mxCell id="uml-17" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;b&gt;RegularToken&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0'&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;+ price(s) = mealRate × meals&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="920" y="430" width="225" height="70" as="geometry"/></mxCell><mxCell id="uml-18" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;b&gt;GuestCoupon&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0'&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;+ price(s) = guestRate × meals&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="920" y="520" width="225" height="70" as="geometry"/></mxCell><mxCell id="uml-19" value="" style="endArrow=block;endFill=0;endSize=12;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="uml-14" target="uml-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uml-20" value="" style="endArrow=block;endFill=0;endSize=12;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="uml-15" target="uml-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uml-21" value="" style="endArrow=block;endFill=0;endSize=12;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="uml-17" target="uml-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uml-22" value="" style="endArrow=block;endFill=0;endSize=12;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="uml-18" target="uml-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uml-23" value="«creates»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="uml-13" target="uml-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="625" y="175"/><mxPoint x="625" y="494"/></Array></mxGeometry></mxCell><mxCell id="uml-24" value="&lt;b&gt;3 patterns · all 3 GoF categories&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style='color:#15803d'&gt;Factory Method&lt;/b&gt; (creational)&lt;br&gt;Creator = TokenSeller · Product = MealToken&lt;br&gt;&lt;br&gt;&lt;b style='color:#c2410c'&gt;Adapter&lt;/b&gt; (structural)&lt;br&gt;Target = PaymentGateway · Adapter = BkashAdapter · Adaptee = BkashClient&lt;br&gt;&lt;br&gt;&lt;b style='color:#7e22ce'&gt;Observer&lt;/b&gt; (behavioral)&lt;br&gt;Subject = EventBus · Observer = Listener" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=11;align=left;spacingLeft=6;fontColor=#1e3a8a;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="60" width="330" height="250" as="geometry"/></mxCell><mxCell id="uml-25" value="&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;solid line + hollow triangle = inherits&lt;br&gt;dashed + hollow triangle = implements&lt;br&gt;open arrow = uses / has&lt;br&gt;dashed open arrow = creates / depends on&lt;br&gt;filled diamond = owns (composition)&lt;br&gt;hollow diamond = has many (aggregation)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=11;align=left;spacingLeft=6;fontColor=#1e3a8a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1200" y="330" width="330" height="150" as="geometry"/></mxCell><mxCell id="uml-26" value="&lt;p style='margin:0;margin-top:4px;text-align:center;'&gt;&lt;b&gt;Settings&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-style:solid;'&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- mealRate: 40 Tk&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- guestRate: 50 Tk&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- cutoffTime: &amp;#x27;23:00&amp;#x27;&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- guestDailyLimit: 10&lt;/p&gt;&lt;p style='margin:0;margin-left:6px;'&gt;- minRecharge: 500 Tk&lt;/p&gt;&lt;p style='marg