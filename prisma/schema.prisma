generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  MANAGER
}

model Hall {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id           Int    @id @default(autoincrement())
  roll         String @unique
  name         String
  email        String
  passwordHash String
  role         Role
  hallId       Int
  hall         Hall   @relation(fields: [hallId], references: [id])

  wallet           Wallet?
  rechargeRequests RechargeRequest[] @relation("RequestOwner")
  decidedRequests  RechargeRequest[] @relation("RequestDecider")
  notifications    Notification[]
  mealTokens       MealToken[]
}

// One row only (id = 1). Money is stored in whole poisha: Tk 40 = 4000.
model Settings {
  id              Int    @id @default(1)
  mealRate        Int    @default(4000)
  guestRate       Int    @default(5000)
  cutoffTime      String @default("23:00")
  guestDailyLimit Int    @default(10)
  minRecharge     Int    @default(50000)
  lowBalanceAt    Int    @default(8000)
}

enum TransactionType {
  RECHARGE
  MEAL_PURCHASE
  GUEST_PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
}

enum TransactionMethod {
  WALLET
  BKASH
  OFFLINE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
}

enum RechargeStatus {
  PENDING
  APPROVED
  REJECTED
}

// balance is in poisha and must never go below 0.
model Wallet {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  user         User          @relation(fields: [userId], references: [id])
  balance      Int           @default(0)
  transactions Transaction[]
}

model Transaction {
  id           Int               @id @default(autoincrement())
  walletId     Int
  wallet       Wallet            @relation(fields: [walletId], references: [id])
  type         TransactionType
  method       TransactionMethod
  amount       Int
  status       TransactionStatus
  balanceAfter Int
  note         String?
  createdAt    DateTime          @default(now())

  @@index([walletId, createdAt])
}

model RechargeRequest {
  id          Int            @id @default(autoincrement())
  userId      Int
  user        User           @relation("RequestOwner", fields: [userId], references: [id])
  amount      Int
  method      TransactionMethod
  reference   String
  status      RechargeStatus @default(PENDING)
  decidedById Int?
  decidedBy   User?          @relation("RequestDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  title     String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

enum MealType {
  LUNCH
  DINNER
  BOTH
}

enum TokenKind {
  REGULAR
  GUEST
}

// date is the meal day in Asia/Dhaka, written "YYYY-MM-DD". price is in poisha.
model MealToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  date      String
  mealType  MealType
  kind      TokenKind
  price     Int
  createdAt DateTime  @default(now())

  @@unique([userId, date, kind])
}

// Order of the history list (FR9). Newest first is the default.
enum HistorySort {
  NEWEST
  OLDEST
}
